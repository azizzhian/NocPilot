# Salin ke install.env (jangan commit) lalu:
#   sudo ./scripts/install.sh ./install.env
#
# Atau export variabel yang sama sebelum menjalankan install.sh

# Wajib
NOCPILOT_REPO=https://github.com/ORG/NocPilot.git
NOCPILOT_DOMAIN=noc.example.com

# Opsional
NOCPILOT_PATH=/var/www/nocpilot
NOCPILOT_BRANCH=main
NOCPILOT_APP_NAME=NocPilot
# Private repo: https://x-access-token:GITHUB_TOKEN@github.com/ORG/NocPilot.git

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nocpilot
DB_USERNAME=nocpilot
DB_PASSWORD=ganti_password_kuat

# 1 = install MariaDB lokal + buat database/user
INSTALL_MYSQL_LOCAL=1

# 1 = jalankan db:seed (user admin demo)
NOCPILOT_SEED=1

# Telegram (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# 1 = pasang nginx site + systemd queue/scheduler
INSTALL_NGINX=1
INSTALL_SYSTEMD=1

# 1 = certbot Let's Encrypt (butuh DNS domain sudah mengarah ke VPS)
INSTALL_SSL=0
CERTBOT_EMAIL=admin@example.com

# PHP-FPM socket (otomatis dideteksi jika kosong)
# PHP_FPM_SOCK=/run/php/php8.3-fpm.sock
